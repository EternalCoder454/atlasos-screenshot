[Desktop Entry]
Type=Application
Name=Screenshot Region
GenericName=Screenshot Tool
Comment=Copy part of the screen as an image, as text (Ctrl) or redacted (Alt)
Icon=applets-screenshooter
# KWin grants org.kde.KWin.ScreenShot2 to the binary this Exec names: keep it
# the absolute path the RPM installs.
Exec=/usr/bin/telamon-screenshot
Terminal=false
StartupNotify=false
Categories=Utility;
Keywords=screenshot;screen;capture;ocr;text;redact;clipboard;
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
X-KDE-Shortcuts=Meta+Shift+S
